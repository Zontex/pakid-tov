{
  "name": "pakid-tov",
  "version": "0.0.1",
  "description": "Finally, a good clerk. Pays Israeli bills from the payment slip, on your own machine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pakid": "dist/src/cli/index.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "billers"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:ids": "node scripts/check-identifiers.mjs",
    "pakid": "node --disable-warning=ExperimentalWarning src/cli/index.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "commander": "^15.1.0",
    "playwright-core": "^1.65.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9",
    "vitest": "^5.1.1"
  }
}
